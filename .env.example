# BetSheet configuration. Copy to .env and adjust. Every value has a sensible
# default; an empty .env is a working setup.

# HTTP port for the API/static server (default 8788).
# The server always binds 127.0.0.1 - BetSheet is local-only by design.
#BETSHEET_PORT=8788

# Logging (wired up in the logging-foundation PR; documented here from day one)
#BETSHEET_LOG_DIR=server/logs
#BETSHEET_LOG_LEVEL=info
#BETSHEET_LOG_MAX_BYTES=10485760
#BETSHEET_LOG_HOT_DAYS=7
#BETSHEET_LOG_COMPRESSED_DAYS=60

# here.now publishing (Phase 4). Without a key, publishes are anonymous with a
# 24-hour expiry - the default, fine for a race day.
#HERENOW_API_KEY=
