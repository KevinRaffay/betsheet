# BetSheet configuration. Copy to .env and adjust. Every value has a sensible
# default; an empty .env is a working setup.

# HTTP port for the API/static server (default 8788).
# The server always binds 127.0.0.1 - BetSheet is local-only by design.
#BETSHEET_PORT=8788

# Logging (wired up in the logging-foundation PR; documented here from day one)
#BETSHEET_LOG_DIR=server/logs
#BETSHEET_LOG_LEVEL=info
#BETSHEET_LOG_MAX_BYTES=10485760
#BETSHEET_LOG_HOT_DAYS=7
#BETSHEET_LOG_COMPRESSED_DAYS=60

# here.now publishing (Phase 4). Without a key, publishes are anonymous with a
# 24-hour expiry - the default, fine for a race day.
#HERENOW_API_KEY=

# LLM cards (D63): "Generate Card from LLM" on a race day. Without a key,
# preview shows "ANTHROPIC_API_KEY is not set" rather than calling out.
# Get one at https://console.anthropic.com/settings/keys
#ANTHROPIC_API_KEY=sk-ant-...
#BETSHEET_LLM_MODEL=claude-sonnet-5

# Live Apify pulls (Phase 3, docs/requirements/apify-equibase-ingest.md):
# on-demand entries/results fetches via shared/apifyEquibase.js, never
# scheduled. Without a token, a fetch fails fast with "APIFY_TOKEN is not
# set" rather than an opaque 401. Get one at
# https://console.apify.com/settings/integrations - each run costs real
# money (from ~$0.02 per race day; see the parseforge/equibase-scraper
# actor's own pricing page), so nothing here runs automatically.
#APIFY_TOKEN=apify_api_...
