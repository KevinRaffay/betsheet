{
  "name": "betsheet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Horse race betting card generator & strategy tracker: generate, grade, simulate.",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "npm run build && node server/index.js",
    "start-qa": "npm run build && node -e \"process.env.BETSHEET_PORT ||= '8902'; import('./server/index.js')\"",
    "build": "vite build",
    "build:static": "vite build --config vite.static.config.js",
    "dev:static": "vite --config vite.static.config.js",
    "preview:static": "vite preview --config vite.static.config.js",
    "dev": "node scripts/dev-preflight.js && concurrently -k -n vite,api -c cyan,magenta \"vite\" \"node scripts/dev-watch.js\"",
    "serve": "node server/index.js",
    "dev:clean": "node scripts/dev-clean.js",
    "dev:restart": "node scripts/dev-clean.js --yes && npm run dev",
    "dev:preview": "node scripts/dev-preview.js",
    "gh": "node scripts/gh-api.js",
    "install-hooks": "node scripts/install-hooks.js",
    "allocate-deliverable": "node scripts/allocate-deliverable.js",
    "check-deliverable-numbers": "node scripts/check-deliverable-numbers.js",
    "check-logging": "node scripts/check-logging.js",
    "check-schema": "node scripts/check-schema.js",
    "check-staleness": "node scripts/check-staleness.js",
    "check-equibase-entries": "node scripts/check-equibase-entries.js",
    "check-equibase-apify-parseforge": "node scripts/check-equibase-apify-parseforge.js",
    "check-equibase-apify-results": "node scripts/check-equibase-apify-results.js",
    "check-equibase-apify-entries-preview": "node scripts/check-equibase-apify-entries-preview.js",
    "check-equibase-apify-results-pull": "node scripts/check-equibase-apify-results-pull.js",
    "check-apify-equibase-ingest": "node scripts/check-apify-equibase-ingest.js",
    "check-apify-equibase-client": "node scripts/check-apify-equibase-client.js",
    "pull-apify-entries": "node scripts/pull-apify-entries.js",
    "pull-apify-results": "node scripts/pull-apify-results.js",
    "check-pull-apify-cli": "node scripts/check-pull-apify-cli.js",
    "check-compare-parsers": "node scripts/check-compare-parsers.js",
    "compare-parsers": "node scripts/compare-parsers.js",
    "check-graded-card-fixtures": "node scripts/check-graded-card-fixtures.js",
    "check-ingest": "node scripts/check-ingest.js",
    "reset": "node scripts/reset.js",
    "check-charts": "node scripts/check-charts.js",
    "check-grading": "node scripts/check-grading.js",
    "check-human-picks": "node scripts/check-human-picks.js",
    "check-llm-cards": "node scripts/check-llm-cards.js",
    "check-llm-input-capture": "node scripts/check-llm-input-capture.js",
    "check-equibase-otr": "node scripts/check-equibase-otr.js",
    "ingest-otr": "node scripts/ingest-otr.js",
    "check-replay": "node scripts/check-replay.js",
    "check-pl": "node scripts/check-pl.js",
    "check-export": "node scripts/check-export.js",
    "check-routing": "node scripts/check-routing.js",
    "check-dmtc-results": "node scripts/check-dmtc-results.js",
    "check-distribution": "node scripts/check-distribution.js",
    "export-trace": "node scripts/export-trace.js",
    "reformat-teller-calls": "node scripts/reformat-teller-calls.js",
    "fix-grade-set-versions": "node scripts/fix-grade-set-versions.js",
    "archive-corpus": "node scripts/archive-corpus.js",
    "backfill-payout-estimates": "node scripts/backfill-payout-estimates.js",
    "batch-equibase": "node scripts/batch-import-equibase-entries.js",
    "pull-race-day": "node scripts/pull-race-day.js",
    "check-track-codes": "node scripts/check-track-codes.js",
    "check-zip-read": "node scripts/check-zip-read.js",
    "check-entries-zip": "node scripts/check-entries-zip.js",
    "check-static-payload": "node scripts/check-static-payload.js",
    "check-static-app": "node scripts/check-static-app.js",
    "check-static-import": "node scripts/check-static-import.js",
    "check-tip-picks": "node scripts/check-tip-picks.js",
    "check-tip-scoring": "node scripts/check-tip-scoring.js",
    "check-tip-staking": "node scripts/check-tip-staking.js",
    "dedupe-tip-cards": "node scripts/dedupe-tip-cards.js",
    "check-module-bindings": "node scripts/check-module-bindings.js",
    "import-static-cards": "node scripts/import-static-cards.js",
    "build-static-payload": "node scripts/build-static-payload.js"
  },
  "dependencies": {
    "@radix-ui/colors": "^3.0.0",
    "apify-client": "^2.25.0",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pdfjs-dist": "^6.3.289",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "vite": "^5.4.0"
  }
}
